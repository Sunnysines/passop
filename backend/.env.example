# PassSaver Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/passop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/passop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/passop

# JWT Authentication Secret Key
JWT_SECRET=passsaver_super_secret_jwt_key_2026_change_this_in_production

# Gmail SMTP Configuration for local development
GMAIL_USER=your_gmail_id@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Brevo (formerly Sendinblue) HTTPS API (Recommended for 100% Free delivery to ANY email address)
# Sign up at https://brevo.com (Free 300 emails/day to ANY recipient) -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend HTTPS Email API (Note: In test mode without custom domain, delivers only to your registered account email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
