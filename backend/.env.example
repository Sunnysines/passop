# PassSaver Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/passop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/passop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/passop

# JWT Authentication Secret Key
JWT_SECRET=passsaver_super_secret_jwt_key_2026_change_this_in_production

# Gmail SMTP Configuration for OTP Delivery
# Use your Gmail address and a 16-character Google App Password (not your regular Gmail password)
# To create an App Password: 
# 1. Go to Google Account > Security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords" -> Create a new App Password named "PassSaver"
GMAIL_USER=your_gmail_id@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
